<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RZDirectReload.Server</AssemblyName>
    <RootNamespace>RZDirectReload.Server</RootNamespace>
    <Version>1.2.0</Version>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- SPT 4.0.13 server references (shared at repo root /libs).
       Private=false: never copy these into the mod output. -->
  <ItemGroup>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>../../libs/SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>../../libs/SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Common">
      <HintPath>../../libs/SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>../../libs/SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
